# ============================================================
# .gitignore — raiz do TCC
# Sobem ao git apenas: Código/ (sem o backup e as saídas
# locais), os PDFs de Monografia/, o README e este arquivo.
# ============================================================

# --- Tudo na raiz é ignorado, exceto o que é reaberto abaixo --
/*
!/.gitignore
!/README.md
!/Código/
!/Monografia/

# --- Monografia: só os PDFs ----------------------------------
/Monografia/*
!/Monografia/*.pdf

# --- Código: backup e saídas locais não sobem ----------------
/Código/backup/
/Código/saidas/

# --- Caches --------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# --- Excel: temporários e lockfiles ---------------------------
~$*.xlsx
~$*.xlsm
*.tmp

# --- Sistema operacional / editores --------------------------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/

# --- Documentos de trabalho (não versionados) -----------------
to_write.md
rascunho.txt
context-*
temp
